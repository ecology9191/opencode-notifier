{
  "name": "opencode-telegram-notifications",
  "version": "0.2.0",
  "description": "OpenCode plugin that sends system, sound, and outbound Telegram notifications with TUI controls",
  "author": "ecology91",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecology9191/opencode-notifier.git"
  },
  "homepage": "https://github.com/ecology9191/opencode-notifier#readme",
  "bugs": {
    "url": "https://github.com/ecology9191/opencode-notifier/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "sounds",
    "logos"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/server.ts src/tui.ts --outdir dist --target node --external node-notifier",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "validate:fast": "npm run typecheck && npm run test",
    "validate": "npm run validate:fast && npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "telegram",
    "notifications",
    "sound",
    "alerts"
  ],
  "dependencies": {
    "is-wsl": "^3.1.0",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.0.224",
    "@types/node": "^22.0.0",
    "@types/node-notifier": "^8.0.5",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  }
}
